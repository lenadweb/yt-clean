{
  "name": "__MSG_appName__",
  "version": "1.0.45",
  "description": "__MSG_appDescription__",
  "default_locale": "en",
  "manifest_version": 3,
  "background": {
    "service_worker": "worker.js"
  },
  "content_scripts": [
    {
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "matches": [
        "*://*.youtube.com/*"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "resources": [
        "fonts/Manrope-VariableFont_wght.ttf"
      ],
      "use_dynamic_url": true
    }
  ],
  "side_panel": {
    "default_path": "sidebar.html"
  },
  "action": {
    "default_title": "__MSG_actionTitle__"
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "permissions": [
    "sidePanel",
    "storage"
  ]
}
